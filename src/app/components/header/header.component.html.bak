<div class="container py-3 border-bottom fixed-top bg-white">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      <h1 class="mb-1">
        <i class="bi bi-code-slash me-2 text-primary"></i>
        {{personal_data.name}}
      </h1>
      <h4 class="text-muted mb-0">
        <i class="bi bi-gear-fill me-2"></i>
        {{personal_data.role}}
      </h4>
    </div>
    <div class="d-flex align-items-center">
      <a [href]="personal_data.linkedIn" target="_blank" class="me-3">
        <i class="display-5 bi bi-linkedin text-primary"></i>
      </a>
      <a [href]="'mailto:' + personal_data.email" class="text-decoration-none">
        <i class="display-6 bi bi-envelope text-primary"></i>
      </a>
    </div>
  </div>
</div>"container py-2 border-bottom fixed-top bg-white">
  <span class="d-flex justify-content-between">
    <div>
      <h1>{{personal_data.name}}</h1>
      <h4>{{personal_data.role}}</h4>
    </div>
    <a [href]="personal_data.linkedIn" target=”_blank”>
      <i class="display-5 bi bi-linkedin text-dark"></i>
    </a>
  </span>
</div>